From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] anbernic: keep RG353PS bootloader display black and silent

Clear the framebuffer to black when U-Boot probes the video device. A no-op
splash callback is insufficient because it leaves pixels handed over by SPL
visible on the panel. Keep the logo symbol enabled for this U-Boot version's
linker references, but do not display the logo.

Do not route the U-Boot console to the video console and enable silent
console output. Linux draws the BaseOS splash after userspace starts.

---
 configs/anbernic-rgxx3-rk3566_defconfig | 7 +++++++
 include/configs/anbernic-rgxx3-rk3566.h | 3 ++-
 drivers/video/video-uclass.c            | 6 +++---
 3 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/configs/anbernic-rgxx3-rk3566_defconfig b/configs/anbernic-rgxx3-rk3566_defconfig
--- a/configs/anbernic-rgxx3-rk3566_defconfig
+++ b/configs/anbernic-rgxx3-rk3566_defconfig
@@ -90,0 +91,7 @@
+CONFIG_VIDEO_LOGO=y
+# CONFIG_SPLASH_SCREEN is not set
+# CONFIG_SPLASH_SOURCE is not set
+CONFIG_SILENT_CONSOLE=y
+CONFIG_SILENT_CONSOLE_UPDATE_ON_RELOC=y
+CONFIG_SILENT_U_BOOT_ONLY=y
+# CONFIG_DEBUG_UART is not set
diff --git a/include/configs/anbernic-rgxx3-rk3566.h b/include/configs/anbernic-rgxx3-rk3566.h
--- a/include/configs/anbernic-rgxx3-rk3566.h
+++ b/include/configs/anbernic-rgxx3-rk3566.h
@@ -3,8 +3,9 @@
 #ifndef __ANBERNIC_RGXX3_RK3566_H
 #define __ANBERNIC_RGXX3_RK3566_H
 
 #define ROCKCHIP_DEVICE_SETTINGS \
-			"stdout=serial\0" \
-			"stderr=serial\0"
+			"stdout=serial\0" \
+			"stderr=serial\0" \
+			"silent=1\0"
 
 #include <configs/rk3568_common.h>
 
diff --git a/drivers/video/video-uclass.c b/drivers/video/video-uclass.c
--- a/drivers/video/video-uclass.c
+++ b/drivers/video/video-uclass.c
@@ -595,10 +595,8 @@ static int show_splash(struct udevice *dev)
 {
-	u8 *data = SPLASH_START(u_boot_logo);
-	int ret;
-
-	ret = video_bmp_display(dev, map_to_sysmem(data), -4, 4, true);
-
-	return 0;
+	/* Clear any image handed over by SPL; keep U-Boot's screen black. */
+	return video_clear(dev);
 }
