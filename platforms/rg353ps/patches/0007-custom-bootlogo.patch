From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] anbernic: load custom bootlogo from exFAT data partition

Enable U-Boot's filesystem-backed splash loader for the RG353PS image.
The image remains a single file in BASEOS_DATA, shared with Linux fbsplash.
If the file or partition cannot be read, normal boot continues and Linux
will render the image after mounting /mnt/SDCARD.

---
 configs/anbernic-rgxx3-rk3566_defconfig |  5 +++++
 common/splash.c                         |  3 ++-
 common/splash_source.c                  |  4 +++-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/configs/anbernic-rgxx3-rk3566_defconfig b/configs/anbernic-rgxx3-rk3566_defconfig
--- a/configs/anbernic-rgxx3-rk3566_defconfig
+++ b/configs/anbernic-rgxx3-rk3566_defconfig
@@ -90,0 +91,5 @@
+CONFIG_BMP=y
+CONFIG_BMP_24BPP=y
+CONFIG_SPLASH_SCREEN=y
+CONFIG_SPLASH_SOURCE=y
+CONFIG_FS_EXFAT=y
diff --git a/common/splash.c b/common/splash.c
--- a/common/splash.c
+++ b/common/splash.c
@@ -37 +37 @@
-		.devpart = "0:1",
+		.devpart = "0:3",
@@ -180,4 +180 @@
-	if (!s)
-		return -EINVAL;
-
-	addr = hextoul(s, NULL);
+	addr = s ? hextoul(s, NULL) : CONFIG_SYS_LOAD_ADDR;
diff --git a/common/splash_source.c b/common/splash_source.c
--- a/common/splash_source.c
+++ b/common/splash_source.c
@@ -331,3 +331,3 @@
 	env_splashsource = env_get("splashsource");
 	if (env_splashsource == NULL)
-		return &locations[0];
+		return &locations[1];
@@ -386,3 +386,3 @@
 	splash_file = env_get("splashfile");
 	if (!splash_file)
-		splash_file = SPLASH_SOURCE_DEFAULT_FILE_NAME;
+		splash_file = "bootlogo/bootlogo.bmp";
@@ -444,5 +444,2 @@
 	env_splashimage_value = env_get("splashimage");
-	if (env_splashimage_value == NULL)
-		return -ENOENT;
-
-	bmp_load_addr = hextoul(env_splashimage_value, 0);
+	bmp_load_addr = env_splashimage_value ? hextoul(env_splashimage_value, 0) : CONFIG_SYS_LOAD_ADDR;
