From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] anbernic: load custom bootlogo from exFAT data partition

Enable U-Boot's filesystem-backed splash loader for the RG353PS image.
The image remains a single file in BASEOS_DATA, shared with Linux fbsplash.
If the file or partition cannot be read, normal boot continues and Linux
will render the image after mounting /mnt/SDCARD.

---
 configs/anbernic-rgxx3-rk3566_defconfig |  4 ++++
 common/splash.c                         |  5 ++---
 common/splash_source.c                 |  2 +-
 3 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/configs/anbernic-rgxx3-rk3566_defconfig b/configs/anbernic-rgxx3-rk3566_defconfig
index 0000000..1111111 100644
--- a/configs/anbernic-rgxx3-rk3566_defconfig
+++ b/configs/anbernic-rgxx3-rk3566_defconfig
@@ -87,6 +87,10 @@ CONFIG_SYSRESET=y
 CONFIG_VIDEO=y
 CONFIG_VIDEO_ROCKCHIP=y
 CONFIG_DISPLAY_ROCKCHIP_DW_MIPI=y
+CONFIG_BMP=y
+CONFIG_BMP_24BPP=y
+CONFIG_SPLASH_SCREEN=y
+CONFIG_SPLASH_SOURCE=y
+CONFIG_FS_EXFAT=y
 CONFIG_VIDEO_BRIDGE=y
 CONFIG_REGEX=y
 # CONFIG_RSA is not set
diff --git a/common/splash.c b/common/splash.c
index 0000000..1111111 100644
--- a/common/splash.c
+++ b/common/splash.c
@@ -34,7 +34,7 @@ static struct splash_location default_splash_locations[] = {
 		.name = "mmc_fs",
 		.storage = SPLASH_STORAGE_MMC,
 		.flags = SPLASH_STORAGE_FS,
-		.devpart = "0:1",
+		.devpart = "0:3",
 	},
 	{
 		.name = "mmc_raw",
@@ -111,7 +111,7 @@ static struct splash_location *select_splash_location(
 	if (!locations || size == 0)
 		return NULL;
 
 	env_splashsource = env_get("splashsource");
 	if (env_splashsource == NULL)
-		return &locations[0];
+		return &locations[1];
 
 	for (i = 0; i < size; i++) {
 		if (!strcmp(locations[i].name, env_splashsource))
@@ -176,8 +176,7 @@ int splash_display(void)
 	if (!CONFIG_IS_ENABLED(SPLASH_SCREEN))
 		return -ENOSYS;
 	s = env_get("splashimage");
-	if (!s)
-		return -EINVAL;
-
-	addr = hextoul(s, NULL);
+	addr = s ? hextoul(s, NULL) : CONFIG_SYS_LOAD_ADDR;
 	ret = splash_screen_prepare();
 	if (ret)
 		return ret;
diff --git a/common/splash_source.c b/common/splash_source.c
index 0000000..1111111 100644
--- a/common/splash_source.c
+++ b/common/splash_source.c
@@ -228,7 +228,7 @@ static inline int splash_umount_ubifs(void)
 #endif
 
 #define SPLASH_SOURCE_DEFAULT_FILE_NAME		"splash.bmp"
-
+ 
 static int splash_load_fs(struct splash_location *location, ulong bmp_load_addr)
 {
 	int res = 0;
@@ -238,7 +238,7 @@ static int splash_load_fs(struct splash_location *location, ulong bmp_load_addr)
 	char *splash_file;
 
 	splash_file = env_get("splashfile");
 	if (!splash_file)
-		splash_file = SPLASH_SOURCE_DEFAULT_FILE_NAME;
+		splash_file = "bootlogo/bootlogo.bmp";
 
 	if (location->storage == SPLASH_STORAGE_USB)
 		res = splash_init_usb();
