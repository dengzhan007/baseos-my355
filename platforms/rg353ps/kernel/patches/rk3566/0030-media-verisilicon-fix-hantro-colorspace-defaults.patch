From: BaseOS RG353PS port
Subject: media: verisilicon: use correct colorimetry for Hantro JPEG formats

The Hantro JPEG encoder exposes raw YUV OUTPUT formats and a compressed
JPEG CAPTURE format. Use sRGB with limited range for raw YUV. Keep JPEG
colorimetry on the encoded queue, including full-range quantization. The
encoded format setup resets the raw queue and propagates colorimetry, so
re-apply the JPEG queue values after that propagation.

---
 drivers/media/platform/verisilicon/hantro_v4l2.c | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/verisilicon/hantro_v4l2.c b/drivers/media/platform/verisilicon/hantro_v4l2.c
index fcf3bd9bcda2..000000000000 100644
--- a/drivers/media/platform/verisilicon/hantro_v4l2.c
+++ b/drivers/media/platform/verisilicon/hantro_v4l2.c
@@ -415,11 +415,23 @@ hantro_reset_fmt(struct v4l2_pix_format_mplane *fmt,
 	memset(fmt, 0, sizeof(*fmt));
 
 	fmt->pixelformat = vpu_fmt->fourcc;
 	fmt->field = V4L2_FIELD_NONE;
-	fmt->colorspace = V4L2_COLORSPACE_JPEG;
-	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
-	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
-	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+
+	if (fmt->pixelformat == V4L2_PIX_FMT_JPEG) {
+		fmt->colorspace = V4L2_COLORSPACE_JPEG;
+		fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+		fmt->quantization =
+			V4L2_MAP_QUANTIZATION_DEFAULT(false, fmt->colorspace,
+						      fmt->ycbcr_enc);
+		fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(fmt->colorspace);
+	} else {
+		fmt->colorspace = V4L2_COLORSPACE_SRGB;
+		fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+		fmt->quantization =
+			V4L2_MAP_QUANTIZATION_DEFAULT(false, fmt->colorspace,
+						      fmt->ycbcr_enc);
+		fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(fmt->colorspace);
+	}
 }
 
 static void
@@ -637,6 +649,17 @@ static int hantro_set_fmt_cap(struct hantro_ctx *ctx,
 	/* Colorimetry information are always propagated. */
 	ctx->src_fmt.colorspace = pix_mp->colorspace;
 	ctx->src_fmt.ycbcr_enc = pix_mp->ycbcr_enc;
 	ctx->src_fmt.xfer_func = pix_mp->xfer_func;
 	ctx->src_fmt.quantization = pix_mp->quantization;
+
+	if (ctx->is_encoder && pix_mp->pixelformat == V4L2_PIX_FMT_JPEG) {
+		pix_mp->colorspace = V4L2_COLORSPACE_JPEG;
+		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		pix_mp->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+		pix_mp->xfer_func = V4L2_XFER_FUNC_SRGB;
+		ctx->dst_fmt.colorspace = pix_mp->colorspace;
+		ctx->dst_fmt.ycbcr_enc = pix_mp->ycbcr_enc;
+		ctx->dst_fmt.quantization = pix_mp->quantization;
+		ctx->dst_fmt.xfer_func = pix_mp->xfer_func;
+	}
 
