From: BaseOS RG353PS port
Subject: media: verisilicon: fix JPEG queue colorimetry after raw-queue reset

The JPEG encoder's CAPTURE format is passed through hantro_set_fmt_cap(),
which also resets and propagates the raw OUTPUT queue's colorimetry. Apply
JPEG full-range colorimetry to the encoded queue after that propagation so
the raw YUV queue keeps its own sRGB/limited-range defaults.

---
 drivers/media/platform/verisilicon/hantro_v4l2.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/media/platform/verisilicon/hantro_v4l2.c b/drivers/media/platform/verisilicon/hantro_v4l2.c
index 1001feee5c07..000000000000 100644
--- a/drivers/media/platform/verisilicon/hantro_v4l2.c
+++ b/drivers/media/platform/verisilicon/hantro_v4l2.c
@@ -637,6 +637,17 @@ static int hantro_set_fmt_cap(struct hantro_ctx *ctx,
 	ctx->src_fmt.ycbcr_enc = pix_mp->ycbcr_enc;
 	ctx->src_fmt.xfer_func = pix_mp->xfer_func;
 	ctx->src_fmt.quantization = pix_mp->quantization;
+
+	if (ctx->is_encoder && pix_mp->pixelformat == V4L2_PIX_FMT_JPEG) {
+		pix_mp->colorspace = V4L2_COLORSPACE_JPEG;
+		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		pix_mp->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+		pix_mp->xfer_func = V4L2_XFER_FUNC_SRGB;
+		ctx->dst_fmt.colorspace = pix_mp->colorspace;
+		ctx->dst_fmt.ycbcr_enc = pix_mp->ycbcr_enc;
+		ctx->dst_fmt.quantization = pix_mp->quantization;
+		ctx->dst_fmt.xfer_func = pix_mp->xfer_func;
+	}
 
 	vpu_debug(0, "CAPTURE codec mode: %d\n", ctx->vpu_dst_fmt->codec_mode);
 	vpu_debug(0, "fmt - w: %d, h: %d\n",
-- 
