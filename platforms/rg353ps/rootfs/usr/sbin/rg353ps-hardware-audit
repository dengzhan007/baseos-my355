#!/bin/sh
# Read-only RG353PS hardware inventory for the experimental BaseOS image.
# Also works as a standalone script copied to /mnt/boot and run with sh.
set -u

OUTDIR=""
[ "$#" -gt 0 ] && OUTDIR="$1"
STAMP="$(date -u +%Y%m%d-%H%M%S 2>/dev/null || echo unknown)"
if [ -z "$OUTDIR" ]; then
  if grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null && [ -w /mnt/boot ]; then
    OUTDIR=/mnt/boot
  else
    OUTDIR=/tmp
  fi
fi
mkdir -p "$OUTDIR" 2>/dev/null || OUTDIR=/tmp
REPORT="$OUTDIR/rg353ps-hardware-audit-$STAMP.txt"
if ! : > "$REPORT" 2>/dev/null; then
  OUTDIR=/tmp
  REPORT="$OUTDIR/rg353ps-hardware-audit-$STAMP.txt"
  : > "$REPORT" || exit 1
fi

exec 3>&1 4>&2
exec > "$REPORT" 2>&1

section() { printf '\n===== %s =====\n' "$1"; }
show_file() {
  if [ -r "$1" ]; then
    printf '\n--- %s ---\n' "$1"
    cat "$1" 2>&1 || :
  fi
}
show_attrs() {
  dir="$1"
  shift
  [ -d "$dir" ] || return 0
  for item in "$dir"/*; do
    [ -e "$item" ] || continue
    printf '\n[%s]\n' "$item"
    for attr in "$@"; do
      if [ -r "$item/$attr" ]; then
        printf '%s=' "$attr"
        tr '\n' ' ' < "$item/$attr" 2>/dev/null || :
        printf '\n'
      fi
    done
  done
}
run_cmd() {
  printf '\n$'
  for arg in "$@"; do printf ' %s' "$arg"; done
  printf '\n'
  "$@" 2>&1
  rc="$?"
  printf '[exit code: %s]\n' "$rc"
  return 0
}

section 'IDENTIFICATION'
printf 'Report: %s\n' "$REPORT"
date -u 2>/dev/null || :
uname -a 2>&1 || :
show_file /proc/cmdline
if [ -r /proc/device-tree/model ]; then
  printf 'device-tree model: '
  tr -d '\000' < /proc/device-tree/model 2>/dev/null || :
  printf '\n'
fi
if [ -r /proc/device-tree/compatible ]; then
  printf 'device-tree compatible:\n'
  tr '\000' '\n' < /proc/device-tree/compatible 2>/dev/null || :
fi

section 'CPU / MEMORY / KERNEL'
show_file /proc/version
show_file /proc/meminfo
show_file /proc/loadavg
show_file /proc/uptime
show_file /proc/modules
show_attrs /sys/devices/system/cpu/cpufreq/policy0 scaling_driver scaling_governor scaling_min_freq scaling_max_freq scaling_cur_freq cpuinfo_min_freq cpuinfo_max_freq

section 'STORAGE / FILESYSTEMS'
show_file /proc/partitions
show_file /proc/mounts
run_cmd ls -l /dev/mmcblk0 /dev/mmcblk0p1 /dev/mmcblk0p2 /dev/mmcblk1 /dev/mmcblk1p1 /dev/mmcblk2 /dev/mmcblk2p1
if command -v df >/dev/null 2>&1; then run_cmd df -h; fi

section 'DISPLAY / DRM / FRAMEBUFFER'
show_attrs /sys/class/drm status enabled modes dpms
show_attrs /sys/class/graphics name virtual_size bits_per_pixel blank mode
show_attrs /sys/class/backlight brightness max_brightness actual_brightness bl_power type
if command -v fbset >/dev/null 2>&1; then run_cmd fbset -i; fi

section 'INPUT DEVICES / BUTTONS / TOUCH'
show_file /proc/bus/input/devices
show_attrs /sys/class/input name phys uniq
run_cmd ls -l /dev/input /dev/input/event0 /dev/input/event1 /dev/input/event2 /dev/input/event3 /dev/input/event4 /dev/input/event5
if command -v evtest >/dev/null 2>&1; then
  echo 'evtest is installed; use evtest /dev/input/eventX interactively to verify physical controls.'
else
  echo 'evtest is not installed; this section inventories devices but does not consume key events.'
fi

section 'AUDIO'
show_file /proc/asound/cards
show_file /proc/asound/devices
show_file /proc/asound/pcm
show_attrs /sys/class/sound
run_cmd ls -l /dev/snd
if command -v aplay >/dev/null 2>&1; then run_cmd aplay -l; else echo 'aplay is not installed'; fi
if command -v amixer >/dev/null 2>&1; then run_cmd amixer scontrols; else echo 'amixer is not installed'; fi

section 'BATTERY / CHARGING / LEDS / THERMAL'
show_attrs /sys/class/power_supply type status present online capacity health voltage_now current_now power_now temp charge_now charge_full charge_counter
show_attrs /sys/class/leds brightness max_brightness trigger
show_attrs /sys/class/thermal type temp mode policy

section 'NETWORK / WIFI / RFKILL'
show_attrs /sys/class/net address operstate carrier mtu
show_attrs /sys/class/ieee80211
show_attrs /sys/class/rfkill name type state soft hard
if command -v ip >/dev/null 2>&1; then run_cmd ip link; run_cmd ip address; run_cmd ip route; fi
if command -v ifconfig >/dev/null 2>&1; then run_cmd ifconfig -a; fi
if command -v iw >/dev/null 2>&1; then run_cmd iw dev; run_cmd iw reg get; else echo 'iw is not installed'; fi
if command -v rfkill >/dev/null 2>&1; then run_cmd rfkill list; else echo 'rfkill utility is not installed'; fi

section 'BLUETOOTH / USB / I2C / SPI'
show_attrs /sys/class/bluetooth address name type
show_attrs /sys/bus/usb/devices product manufacturer speed
show_attrs /sys/bus/i2c/devices name modalias
show_attrs /sys/bus/spi/devices modalias
if command -v hciconfig >/dev/null 2>&1; then run_cmd hciconfig -a; else echo 'hciconfig is not installed'; fi
if command -v bluetoothctl >/dev/null 2>&1; then run_cmd bluetoothctl show; else echo 'bluetoothctl is not installed'; fi

section 'V4L2 / HANTRO'
if command -v v4l2-ctl >/dev/null 2>&1; then
  run_cmd v4l2-ctl --list-devices
  for dev in /dev/video0 /dev/video1; do
    [ -e "$dev" ] || continue
    run_cmd v4l2-ctl -d "$dev" --all
    run_cmd v4l2-ctl -d "$dev" --list-formats-ext
    run_cmd v4l2-ctl -d "$dev" --list-formats-out-ext
  done
else
  echo 'v4l2-ctl is not installed'
fi
if command -v v4l2-compliance >/dev/null 2>&1; then
  for dev in /dev/video0 /dev/video1; do
    [ -e "$dev" ] || continue
    run_cmd v4l2-compliance -d "$dev"
  done
else
  echo 'v4l2-compliance is not installed'
fi

section 'RUNNING PROCESSES'
run_cmd ps

section 'RELEVANT KERNEL LOG'
dmesg 2>&1 | grep -iE 'error|fail|hantro|video-codec|drm|panel|backlight|input|gpio|i2c|spi|mmc|sdhci|dwmmc|wifi|wlan|rtw|bluetooth|hci|audio|alsa|sound|thermal|battery|power|iommu|fault|regulatory|timeout|overcurrent' | tail -n 250 || :

section 'END'
echo "Report saved to: $REPORT"
exec 1>&3 2>&4
cat "$REPORT"
