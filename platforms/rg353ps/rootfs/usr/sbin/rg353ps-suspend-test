#!/bin/sh
# Opt-in, one-shot suspend/resume test for RG353PS.
# First stage only: s2idle. It does not change the normal power-key behavior.
set -u

MODE=${1:-}
if [ "$MODE" != "s2idle" ]; then
  echo "usage: $0 s2idle" >&2
  exit 2
fi

OUTDIR=/tmp
if grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null && [ -w /mnt/boot ]; then
  OUTDIR=/mnt/boot
fi
STAMP="$(date -u +%Y%m%d-%H%M%S 2>/dev/null || echo unknown)"
REPORT="$OUTDIR/rg353ps-suspend-test-$MODE-$STAMP.txt"
if ! : > "$REPORT" 2>/dev/null; then
  REPORT="/tmp/rg353ps-suspend-test-$MODE-$STAMP.txt"
  : > "$REPORT" || exit 1
fi
exec >> "$REPORT" 2>&1

# Runtime state for safe cleanup if a precondition fails or suspend returns.
POWER_GRAB_PID=
POWER_GRAB_LOG=
MODE_CHANGED=0
BACKLIGHT_CHANGED=0
BACKLIGHT=
BACKLIGHT_OLD=

release_power_grab() {
  [ -n "$POWER_GRAB_PID" ] || return 0
  # Keep the PMIC key exclusively grabbed through its release event. Otherwise
  # the frontend can interpret the same keypress that woke the kernel as a
  # second request to sleep/blank the display.
  i=0
  while [ "$i" -lt 30 ] && kill -0 "$POWER_GRAB_PID" 2>/dev/null; do
    grep -q 'code 116 (KEY_POWER), value 0' "$POWER_GRAB_LOG" 2>/dev/null && break
    sleep 0.1
    i=$((i+1))
  done
  if ! grep -q 'code 116 (KEY_POWER), value 0' "$POWER_GRAB_LOG" 2>/dev/null; then
    log "WARNING: KEY_POWER release not observed before grab timeout"
  fi
  kill -TERM "$POWER_GRAB_PID" 2>/dev/null || :
  wait "$POWER_GRAB_PID" 2>/dev/null || :
  POWER_GRAB_PID=
  if [ -n "$POWER_GRAB_LOG" ] && [ -r "$POWER_GRAB_LOG" ]; then
    printf '\n--- exclusive power-key event trace ---\n'
    cat "$POWER_GRAB_LOG"
    rm -f "$POWER_GRAB_LOG"
  fi
  POWER_GRAB_LOG=
}

cleanup() {
  cleanup_rc=$?
  if [ "$BACKLIGHT_CHANGED" -eq 1 ] && [ -n "$BACKLIGHT" ] && [ -w "$BACKLIGHT" ]; then
    printf '%s\n' "$BACKLIGHT_OLD" > "$BACKLIGHT" 2>/dev/null || :
    BACKLIGHT_CHANGED=0
  fi
  if [ "$MODE_CHANGED" -eq 1 ] && [ -w /sys/power/mem_sleep ]; then
    printf '%s\n' "$ORIGINAL_MODE" > /sys/power/mem_sleep 2>/dev/null || :
    MODE_CHANGED=0
  fi
  release_power_grab
  sync
  return "$cleanup_rc"
}
trap cleanup EXIT

log() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo time-unknown)" "$*"
  printf 'RG353PS suspend test: %s\n' "$*" > /dev/kmsg 2>/dev/null || :
}
fail() {
  log "ERROR: $*"
  log "No suspend attempt was made if this error occurred before the suspend step."
  exit 1
}
read_attr() {
  [ -r "$1" ] && cat "$1" 2>/dev/null || echo unavailable
}

log "report=$REPORT"
log "mode=$MODE"
log "kernel=$(uname -r 2>/dev/null || echo unknown)"
log "This test is opt-in and does not alter the default power-key policy."

# Never test suspend while the shared user partition may be exported to a PC.
for marker in /run/baseos-usb-storage.request /run/baseos-usb-storage.boot-request /run/baseos-frontend-paused; do
  [ ! -e "$marker" ] || fail "USB storage/session transition marker exists: $marker"
done

[ -r /sys/power/state ] || fail "/sys/power/state is not readable"
[ -w /sys/power/state ] || fail "/sys/power/state is not writable"
grep -qw mem /sys/power/state || fail "kernel does not expose the mem suspend state"
[ -r /sys/power/mem_sleep ] && [ -w /sys/power/mem_sleep ] || fail "/sys/power/mem_sleep is unavailable"

MEM_MODES="$(tr -d '[]' < /sys/power/mem_sleep 2>/dev/null || :)"
case " $MEM_MODES " in
  *" s2idle "*) ;;
  *) fail "s2idle is not listed in /sys/power/mem_sleep: $(read_attr /sys/power/mem_sleep)" ;;
esac

ORIGINAL_MODE="$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)"
[ -n "$ORIGINAL_MODE" ] || fail "cannot determine the currently selected mem_sleep mode"

# A writable backlight control makes the test visibly enter and leave the
# suspend window. Keep its original value and restore it on every return path.
BACKLIGHT=
BACKLIGHT_OLD=
for candidate in /sys/class/backlight/*/brightness; do
  [ -r "$candidate" ] && [ -w "$candidate" ] || continue
  candidate_value="$(cat "$candidate" 2>/dev/null || :)"
  case "$candidate_value" in ''|*[!0-9]*) continue ;; esac
  BACKLIGHT="$candidate"
  BACKLIGHT_OLD="$candidate_value"
  break
done
[ -n "$BACKLIGHT" ] || fail "no writable backlight brightness control was found"

# Find the PMIC power-key event device by its stable sysfs name, not eventN.
POWER_EVENT=
for name_file in /sys/class/input/event*/device/name; do
  [ -r "$name_file" ] || continue
  name_value="$(cat "$name_file" 2>/dev/null || :)"
  if [ "$name_value" = "rk805 pwrkey" ]; then
    event_name=${name_file#/sys/class/input/}
    event_name=${event_name%%/*}
    POWER_EVENT="/dev/input/$event_name"
    break
  fi
done
[ -n "$POWER_EVENT" ] || fail "could not find the rk805 pwrkey input device"
command -v evtest >/dev/null 2>&1 || fail "evtest is missing; refusing to suspend without wake-key isolation"
POWER_GRAB_LOG="/tmp/rg353ps-suspend-powerkey-$STAMP.log"

log "state=$(read_attr /sys/power/state | tr '\n' ' ')"
log "mem_sleep_before=$(read_attr /sys/power/mem_sleep | tr '\n' ' ')"
log "wakeup_count_before=$(read_attr /sys/power/wakeup_count | tr '\n' ' ')"
log "suspend_success_before=$(read_attr /sys/power/suspend_stats/success)"
log "suspend_fail_before=$(read_attr /sys/power/suspend_stats/fail)"
log "backlight=$BACKLIGHT brightness_before=$BACKLIGHT_OLD"
log "Waiting 8 seconds for the frontend to settle before blanking the screen."
sleep 8

if ! printf 's2idle\n' > /sys/power/mem_sleep 2>/dev/null; then
  fail "failed to select s2idle; no suspend was attempted"
fi
SELECTED_MODE="$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)"
if [ "$SELECTED_MODE" != "s2idle" ]; then
  printf '%s\n' "$ORIGINAL_MODE" > /sys/power/mem_sleep 2>/dev/null || :
  fail "kernel did not select s2idle: $(read_attr /sys/power/mem_sleep)"
fi
MODE_CHANGED=1


# Grab the physical power-key event before suspending. EVIOCGRAB only
# diverts userspace input events; it does not disable the PMIC's wake source.
: > "$POWER_GRAB_LOG" || fail "cannot create power-key trace"
evtest --grab "$POWER_EVENT" > "$POWER_GRAB_LOG" 2>&1 &
POWER_GRAB_PID=$!
i=0
while [ "$i" -lt 30 ] && ! grep -q 'Testing .*interrupt to exit' "$POWER_GRAB_LOG" 2>/dev/null; do
  kill -0 "$POWER_GRAB_PID" 2>/dev/null || fail "evtest exited before power-key grab was ready"
  sleep 0.1
  i=$((i+1))
done
sleep 0.2
grep -q 'Testing .*interrupt to exit' "$POWER_GRAB_LOG" 2>/dev/null || fail "evtest power-key monitor did not start"
if grep -q 'This device is grabbed by another process' "$POWER_GRAB_LOG" 2>/dev/null; then
  fail "power-key event is already grabbed by another process; no suspend attempted"
fi
log "power_key_event=$POWER_EVENT; exclusive input grab active"
log "The physical power key can wake the kernel, but its press/release will not reach NextUI during this test."

# Flush the imminent-suspend log before blanking. No artificial one-second
# blank interval: reduce the chance the wake key is pressed before mem suspend.
sync
log "Entering s2idle now. Briefly press and release the physical power button to wake the device."
log "If the device does not wake, this pre-suspend report was flushed before the state write."
sync
if ! printf '0\n' > "$BACKLIGHT" 2>/dev/null; then
  fail "could not turn off the backlight; no suspend was attempted"
fi
BACKLIGHT_CHANGED=1
if printf 'mem\n' > /sys/power/state 2>> "$REPORT"; then
  SUSPEND_RC=0
else
  SUSPEND_RC=$?
fi

# This section is reached after successful resume or after the kernel rejects
# the suspend request. If the hardware does not resume, the pre-suspend report
# remains available on BASEOS_BOOT.
log "suspend_write_exit=$SUSPEND_RC"
log "resumed_at=$(date -u 2>/dev/null || echo unavailable)"
release_power_grab
if [ -n "$BACKLIGHT" ] && [ -w "$BACKLIGHT" ]; then
  if printf '%s\n' "$BACKLIGHT_OLD" > "$BACKLIGHT" 2>/dev/null; then
    BACKLIGHT_CHANGED=0
  else
    log "WARNING: failed to restore original backlight brightness"
  fi
fi
if [ -w /sys/power/mem_sleep ]; then
  if printf '%s\n' "$ORIGINAL_MODE" > /sys/power/mem_sleep 2>/dev/null; then
    MODE_CHANGED=0
  else
    log "WARNING: could not restore mem_sleep mode $ORIGINAL_MODE"
  fi
fi
for attr in /sys/class/backlight/backlight/brightness /sys/class/backlight/backlight/actual_brightness /sys/class/backlight/backlight/bl_power /sys/class/graphics/fb0/blank; do
  log "$attr=$(read_attr "$attr" | tr '\n' ' ')"
done
sync

log "mem_sleep_after=$(read_attr /sys/power/mem_sleep | tr '\n' ' ')"
log "wakeup_count_after=$(read_attr /sys/power/wakeup_count | tr '\n' ' ')"
log "suspend_success_after=$(read_attr /sys/power/suspend_stats/success)"
log "suspend_fail_after=$(read_attr /sys/power/suspend_stats/fail)"
log "failed_freeze=$(read_attr /sys/power/suspend_stats/failed_freeze)"
log "failed_prepare=$(read_attr /sys/power/suspend_stats/failed_prepare)"
log "failed_suspend=$(read_attr /sys/power/suspend_stats/failed_suspend)"
log "failed_suspend_noirq=$(read_attr /sys/power/suspend_stats/failed_suspend_noirq)"
log "failed_resume=$(read_attr /sys/power/suspend_stats/failed_resume)"
log "Relevant kernel messages after test:"
dmesg 2>&1 | grep -iE 'suspend|resume|wakeup|wake-up|PM:|rockchip.*pm|power domain|psci|rk805|rk817|gpio.*key|adc.*key|panel|backlight|drm' | tail -n 160 || :
log "Test helper completed; this test alone does not establish deep suspend support."
exit "$SUSPEND_RC"
