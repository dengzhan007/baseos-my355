#!/bin/sh
# Minimal RG353PS bring-up init. This deliberately does not launch a frontend yet.
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null || :
mount -t sysfs sysfs /sys 2>/dev/null || :
mount -t devtmpfs devtmpfs /dev 2>/dev/null || :
mkdir -p /dev/pts /run /tmp /mnt/boot /mnt/roms
mount -t devpts devpts /dev/pts 2>/dev/null || :
mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || :
mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null || :
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || :
/sbin/mdev -s 2>/dev/null || :

say() {
  echo "$*" > /dev/kmsg 2>/dev/null || :
  echo "$*" > /dev/tty0 2>/dev/null || :
  echo "$*" > /dev/ttyS2 2>/dev/null || :
}

say "BaseOS RG353PS experimental bring-up"
say "Kernel: $(uname -r)"
if [ -r /proc/device-tree/model ]; then
  MODEL="$(tr -d '\000' < /proc/device-tree/model)"
  say "Device: $MODEL"
fi

# Storage and panel support are built into this kernel configuration. Load the
# mainline RTL8821CS Wi-Fi function; Bluetooth is attached through UART/serdev.
if [ -x /sbin/modprobe ]; then
  /sbin/modprobe rtw88_8821cs 2>/dev/null || :
  /sbin/modprobe hci_uart 2>/dev/null || :
  /sbin/modprobe btrtl 2>/dev/null || :
  if /sbin/modprobe hantro-vpu 2>/dev/null; then
    say "Hantro VPU driver loaded (decoder/encoder nodes should be available)"
  else
    say "WARNING: failed to load Hantro VPU driver"
  fi
fi

say "BaseOS userspace is up."
say "This is a hardware test image, not the finished frontend."

# Keep later driver notices in the kernel ring buffer without overwriting the
# diagnostic console. The full log remains available through `dmesg`.
dmesg -n 4 2>/dev/null || :
